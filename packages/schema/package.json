{
  "name": "@barnacle/schema",
  "version": "1.0.0",
  "description": "PageGraph JSON Schema for barnacle CMS",
  "keywords": [
    "barnacle",
    "cms",
    "pagegraph",
    "json-schema",
    "typescript",
    "content-model",
    "validation",
    "static-site-cms"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "validate": "ts-node src/validate.ts",
    "test": "jest"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.11.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.11"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  }
}
